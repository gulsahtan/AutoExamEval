<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoExamEval</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container nav-content">
                <div class="nav-left">
                    <a class="brand" asp-controller="Home" asp-action="Index">AutoExamEval</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Course" asp-action="Index">Courses</a>
                        <a asp-controller="Exam" asp-action="Index">Exams</a>
                        <a asp-controller="Question" asp-action="Index">Questions</a>
                    }
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main class="container py-3">
        @RenderBody()
    </main>

    <footer class="footer container">
        <small>&copy; @DateTime.Now.Year - AutoExamEval</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
