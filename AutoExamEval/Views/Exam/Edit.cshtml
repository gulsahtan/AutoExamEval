@model AutoExamEval.ViewModels.Exam.ExamEditViewModel

@{
    ViewData["Title"] = "Edit Exam";
}

<h2>Edit Exam</h2>

<form asp-action="Edit" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="CourseId"></label>
        <select asp-for="CourseId" asp-items="Model.CourseOptions">
            <option value="">Select Course</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ExamTitle"></label>
        <input asp-for="ExamTitle" />
        <span asp-validation-for="ExamTitle" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ExamType"></label>
        <select asp-for="ExamType" asp-items="Model.ExamTypeOptions">
            <option value="">Select Exam Type</option>
        </select>
        <span asp-validation-for="ExamType" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ExamDate"></label>
        <input asp-for="ExamDate" type="date" />
        <span asp-validation-for="ExamDate" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ExamLocation"></label>
        <input asp-for="ExamLocation" />
        <span asp-validation-for="ExamLocation" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="InstructorName"></label>
        <input asp-for="InstructorName" />
        <span asp-validation-for="InstructorName" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="DurationMinutes"></label>
        <input asp-for="DurationMinutes" type="number" min="1" />
        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="TotalScore"></label>
        <input asp-for="TotalScore" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="TotalScore" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="TemplateType"></label>
        <input asp-for="TemplateType" />
        <span asp-validation-for="TemplateType" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button class="btn" type="submit">Update</button>
    <a asp-action="ByCourse" asp-route-courseId="@Model.CourseId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
