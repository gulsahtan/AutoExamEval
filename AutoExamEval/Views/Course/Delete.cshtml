@model AutoExamEval.ViewModels.Course.CourseDeleteViewModel

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>
<p>Bu dersi silmek istediğinizden emin misiniz?</p>

<dl>
    <dt>Course Code</dt>
    <dd>@Model.CourseCode</dd>

    <dt>Course Name</dt>
    <dd>@Model.CourseName</dd>

    <dt>Term</dt>
    <dd>@Model.Term</dd>

    <dt>Academic Year</dt>
    <dd>@Model.AcademicYear</dd>

    <dt>Instructor Name</dt>
    <dd>@Model.InstructorName</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button class="btn" type="submit">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>
