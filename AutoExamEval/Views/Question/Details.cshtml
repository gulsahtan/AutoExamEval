@model AutoExamEval.ViewModels.Question.QuestionDetailsViewModel

@{
    ViewData["Title"] = "Question Details";
}

<h2>Question Details</h2>

<dl>
    <dt>Course</dt>
    <dd>@Model.CourseName</dd>

    <dt>Exam</dt>
    <dd>@Model.ExamTitle</dd>

    <dt>Question No</dt>
    <dd>@Model.QuestionNo</dd>

    <dt>Question Type</dt>
    <dd>@Model.QuestionType</dd>

    <dt>Question Text</dt>
    <dd>@Model.QuestionText</dd>

    <dt>Option A</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.OptionA) ? "-" : Model.OptionA)</dd>

    <dt>Option B</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.OptionB) ? "-" : Model.OptionB)</dd>

    <dt>Option C</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.OptionC) ? "-" : Model.OptionC)</dd>

    <dt>Option D</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.OptionD) ? "-" : Model.OptionD)</dd>

    <dt>Option E</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.OptionE) ? "-" : Model.OptionE)</dd>

    <dt>Correct Answer</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.CorrectAnswer) ? "-" : Model.CorrectAnswer)</dd>

    <dt>Answer Text</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.AnswerText) ? "-" : Model.AnswerText)</dd>

    <dt>Score</dt>
    <dd>@Model.Score</dd>

    <dt>Created At (UTC)</dt>
    <dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt>Updated At (UTC)</dt>
    <dd>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="ByExam" asp-route-examId="@Model.ExamId">Back to Exam Questions</a>
</p>
