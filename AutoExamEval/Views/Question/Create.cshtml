@model AutoExamEval.ViewModels.Question.QuestionCreateViewModel

@{
    ViewData["Title"] = "New Question";
}

<h2>New Question</h2>

<form asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="ExamId"></label>
        <select asp-for="ExamId" asp-items="Model.ExamOptions">
            <option value="">Select Exam</option>
        </select>
        <span asp-validation-for="ExamId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="QuestionNo"></label>
        <input asp-for="QuestionNo" type="number" min="1" />
        <span asp-validation-for="QuestionNo" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="QuestionText"></label>
        <textarea asp-for="QuestionText" rows="5"></textarea>
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="QuestionType"></label>
        <select asp-for="QuestionType" asp-items="Model.QuestionTypeOptions" id="questionTypeSelect">
            <option value="">Select Question Type</option>
        </select>
        <span asp-validation-for="QuestionType" class="text-danger"></span>
    </div>

    <div id="multipleChoiceFields">
        <div>
            <label asp-for="OptionA"></label>
            <input asp-for="OptionA" />
            <span asp-validation-for="OptionA" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="OptionB"></label>
            <input asp-for="OptionB" />
            <span asp-validation-for="OptionB" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="OptionC"></label>
            <input asp-for="OptionC" />
            <span asp-validation-for="OptionC" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="OptionD"></label>
            <input asp-for="OptionD" />
            <span asp-validation-for="OptionD" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="OptionE"></label>
            <input asp-for="OptionE" />
            <span asp-validation-for="OptionE" class="text-danger"></span>
        </div>
    </div>

    <div>
        <label asp-for="CorrectAnswer"></label>
        <input asp-for="CorrectAnswer" />
        <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Score"></label>
        <input asp-for="Score" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="AnswerText"></label>
        <textarea asp-for="AnswerText" rows="3"></textarea>
        <span asp-validation-for="AnswerText" class="text-danger"></span>
    </div>

    <button class="btn" type="submit">Save</button>
    <a asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleQuestionTypeFields() {
            const typeElement = document.getElementById('questionTypeSelect');
            const selectedType = typeElement ? typeElement.value : '';
            const multipleChoiceFields = document.getElementById('multipleChoiceFields');

            if (!multipleChoiceFields) return;

            if (selectedType === 'MultipleChoice') {
                multipleChoiceFields.style.display = 'block';
            } else {
                multipleChoiceFields.style.display = 'none';
            }
        }

        document.getElementById('questionTypeSelect')?.addEventListener('change', toggleQuestionTypeFields);
        toggleQuestionTypeFields();
    </script>
}
